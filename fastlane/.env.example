# Environment for the store lanes (fastlane/Fastfile). Copy to fastlane/.env (git-ignored) or set the
# same variables in CI; fastlane loads fastlane/.env by itself.

# Google Play: a service account JSON (the file's content) with release access to the app.
GOOGLE_PLAY_JSON_KEY={"type":"service_account","project_id":"your-project","private_key":"…","client_email":"…"}

# App Store Connect: an API key file (JSON) — upload and match.
APP_STORE_CONNECT_API_KEY_PATH=/path/to/app-store-connect-key.json

# Bundle id per flavor, as the Xcode project's configurations set them.
IOS_BUNDLE_ID_PROD=com.example.app
IOS_BUNDLE_ID_BETA=com.example.app.beta

# match: the certificates repository and its passphrase.
MATCH_GIT_URL=git@github.com:your-org/certificates.git
MATCH_PASSWORD=
