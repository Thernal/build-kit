# Signing, as build-logic/convention/…/Signing.kt reads it. Two places take this shape:
#
#   config/signing/debug/keystore.properties    the team's shared debug keystore — COMMITTED with it
#                                                (Google sign-in, Firebase and app links pin its
#                                                signature); signs debug and non-production releases
#   config/signing/release/keystore.properties  the production keystore — NEVER committed (the
#                                                directory is git-ignored); CI writes it from secrets
#   config/signing/release/<app>/keystore.properties
#                                                one app's own production keystore, read before the
#                                                shared one above — a repository with several apps
#                                                signs each with its own key
#
# Copy this file into either directory as keystore.properties, the keystore beside it.
# storeFile is relative to that directory.

storeFile=app.jks
storePassword=change-me
keyAlias=app
keyPassword=change-me
