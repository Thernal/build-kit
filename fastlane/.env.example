# Environment for the store lanes (fastlane/Fastfile). A release pipeline sets these as CI/CD variables; for a
# run on a machine, copy this file to fastlane/.env (git-ignored) — fastlane loads it by itself. Every *_FILE is
# an absolute path. The project's own choices (channels, ids, tracks, rollout) are app.release.* keys in
# gradle.properties, not variables (README → Releasing).

# The app (apps/<name>); optional when the repository ships one.
APP=customer

# The release: X.Y.Z and a build number above every build of the app in both stores; the notes (at most 500
# characters, Google Play's limit). RELEASE_NOTES_OVERRIDE_FILE, when it exists and isn't blank, replaces them.
VERSION_NAME=1.0.0
BUILD_NUMBER=1
RELEASE_NOTES_FILE=/path/to/release-notes.txt

# Google Play: a service account key with release access to the app.
GOOGLE_PLAY_JSON_KEY_FILE=/path/to/google-play.json

# Android upload keystore, copied to config/signing/release/ for the build and removed after; leave both unset
# when config/signing/release/ already holds it. storeFile in the properties is the keystore's file name.
ANDROID_KEYSTORE_FILE=/path/to/upload.keystore
ANDROID_KEYSTORE_PROPERTIES_FILE=/path/to/keystore.properties

# App Store Connect API key (App Manager role).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILE=/path/to/AuthKey.p8

# match: the certificates repository and its passphrase. With a deploy key, git uses only that key and the host
# line(s) below (ssh-keyscan <host>, checked against the host's published fingerprint); without one, the
# machine's own ssh setup.
MATCH_GIT_URL=git@github.com:your-org/certificates.git
MATCH_PASSWORD=
MATCH_SSH_KEY_FILE=/path/to/match-deploy-key
MATCH_KNOWN_HOSTS="github.com ssh-ed25519 AAAA…"

# TestFlight external groups and Beta App Review (the demo logins of the beta and the production backend).
TESTFLIGHT_CLOSED_GROUP=Closed Beta
TESTFLIGHT_OPEN_GROUP=Open Beta
BETA_REVIEW_CONTACT_EMAIL=
BETA_REVIEW_CONTACT_FIRST_NAME=
BETA_REVIEW_CONTACT_LAST_NAME=
BETA_REVIEW_CONTACT_PHONE=
BETA_REVIEW_DEMO_USER_DEV=
BETA_REVIEW_DEMO_PASSWORD_DEV=
BETA_REVIEW_DEMO_USER_PROD=
BETA_REVIEW_DEMO_PASSWORD_PROD=
